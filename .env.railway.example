# ==============================================================================
# SKILLINK RAILWAY CLOUD ENVIRONMENT CONFIGURATION
# I-copy at i-paste ang mga variable na ito sa Railway Dashboard -> Variables Tab
# ==============================================================================

APP_NAME=SKILLINK
APP_ENV=production
APP_KEY=base64:7bA9v3h6T8+n1f+t+zX8v1x4t+4X8r3y2f1+8z+5W4A=
APP_DEBUG=false
APP_URL=${{RAILWAY_PUBLIC_DOMAIN}}

LOG_CHANNEL=stack
LOG_LEVEL=info

# Railway MySQL Plugin Integration (Awtomatikong binibigay ng Railway MySQL Service):
DB_CONNECTION=mysql
DB_HOST=${{MYSQLHOST}}
DB_PORT=${{MYSQLPORT}}
DB_DATABASE=${{MYSQLDATABASE}}
DB_USERNAME=${{MYSQLUSER}}
DB_PASSWORD=${{MYSQLPASSWORD}}

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# GMAIL SMTP Notification Configuration (Optionally setup when ready):
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-peso-gmail@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@magalang.gov.ph"
MAIL_FROM_NAME="PESO Magalang SKILLINK"
